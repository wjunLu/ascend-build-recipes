# Metadata and defaults consumed by the pipeline on the main branch.
COMPONENT=flash-attention-npu
SOURCE_REPO=https://github.com/MinghuasLab/flash-attention-npu.git
SOURCE_REF=9c9f00648fa150e84228a9b757990485fc670df3
OBS_PREFIX=source-builds
ARTIFACT_PATTERN=flash_attn_npu-*.whl

# Build inputs. Override these here when the torch or CANN baseline changes.
TORCH_VERSION=2.10.0
TORCH_NPU_VERSION=2.10.0.post7
FLASH_ATTN_BUILD_VERSION=all
FLASH_ATTN_BUILD_NPU=all
