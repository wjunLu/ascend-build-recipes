# Metadata and defaults consumed by the pipeline on the main branch.
COMPONENT=mooncake
SOURCE_REPO=https://github.com/kvcache-ai/Mooncake.git
SOURCE_REF=v0.3.14-pre-3
OBS_PREFIX=source-builds
ARTIFACT_PATTERN=mooncake_transfer_engine_npu-*.whl

# Build inputs. HIXL is built from source and installed before Mooncake.
HIXL_REPO=https://gitcode.com/cann/hixl.git
HIXL_REF=
MOONCAKE_BUILD_JOBS=2
